// ============================================================================
// P2Less — Universal Conversational Access & Integration Platform
// "Stop logging into systems. Start talking to them."
//
// SQLite is used for zero-setup local development. Enum-like fields are stored
// as String (SQLite has no native enums). Swap `provider` to "postgresql" for
// production — every model is portable. Multi-tenancy is enforced in the app
// layer (every tenant-owned row carries tenantId and queries are scoped); in
// production this is backed by Postgres Row-Level Security on the same columns.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Platform-wide key-value config the super admin can change at runtime
/// without a redeploy — which AI provider is primary, and the per-unit
/// price/cost assumptions used for the plan-margin calculator. Falls back to
/// the code-level defaults (env var / hardcoded constants) when a key is
/// unset, so the platform works correctly before an admin ever touches this.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Super-admin-entered cost assumption per AI provider — what P2Less actually
/// pays per successful call, in KES. Providers don't expose a simple public
/// "current spend" API for the free/cheap tiers in use here, so this is a
/// deliberate estimate the admin keeps current, not a live billing feed —
/// multiplied against REAL call counts from AiProviderStat to estimate spend.
model AiProviderConfig {
  provider      String   @id
  costPerCallKes Float   @default(0)
  updatedAt     DateTime @updatedAt
}

/// Real, per-request AI cost ledger — captures actual token usage (where the
/// provider's response includes it) instead of an estimated cost-per-call,
/// so the platform P&L reflects what was ACTUALLY spent, not a guess. Written
/// fire-and-forget from callOnce() in ai.ts on every successful call; never
/// blocks or fails a real reply if the write itself fails.
model AiRequestLog {
  id           String   @id @default(cuid())
  tenantId     String? // null when the tenant isn't known yet at call time (e.g. voice-note transcription before routing) — real, not omitted-to-hide
  provider     String
  model        String
  feature      String // "understand" | "small_talk" | "humanize_reply" | "order_step" | "commerce_classify" | "cv_tool" | "transcribe_audio" | ...
  requestId    String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  costUsd      Float    @default(0) // computed from ModelPricing in effect at createdAt — 0 if no pricing configured yet (honest, not guessed)
  costKes      Float    @default(0)
  revenueKes   Float    @default(0) // the tenant's current price_ai_kes at call time — what this request is worth in billing terms
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([provider, model])
  @@index([createdAt])
}

/// Per-token provider pricing, VERSIONED — a new row is inserted (never
/// edited in place) whenever a price changes, with `effectiveFrom` marking
/// when it took effect. Historical cost calculations always use whichever
/// row was in effect at the time, so they don't silently change if the
/// provider raises or lowers prices later. Prices are USD per 1M tokens
/// (the unit every provider's own pricing page uses), converted to KES via
/// the "usd_to_kes_rate" PlatformSetting at calculation time.
model ModelPricing {
  id                  String   @id @default(cuid())
  provider             String
  model                String
  inputPerMillionUsd   Float    @default(0)
  outputPerMillionUsd  Float    @default(0)
  effectiveFrom        DateTime @default(now())
  setById              String? // super admin user id who set this price
  createdAt            DateTime @default(now())

  @@index([provider, model, effectiveFrom])
}

/// Admin-configurable rule for WHEN and via WHICH channel a billing event
/// notifies someone — e.g. "renewal_reminder via whatsapp at 7 days before"
/// or "incident_critical via email, immediately". Originally billing-only;
/// Priority 6 generalized it to every event in the platform that needs to
/// reach a human (see Notification below) — the engine reads these instead
/// of a hard-coded schedule, same as it always did.
model NotificationRule {
  id         String   @id @default(cuid())
  event      String // renewal_reminder | payment_received | payment_failed | subscription_expired | account_suspended | account_reactivated | payment_reconciliation_needed | incident_critical | incident_opened | ticket_created | ticket_assigned | ticket_sla_breached | whatsapp_connection_failed | ai_provider_degraded | usage_limit_exceeded | onboard_signup_anomaly
  channel    String // email | whatsapp | sms — see Notification for which channels actually dispatch today
  timingDays Int      @default(0) // days BEFORE the triggering date (renewal reminders); 0 = fires immediately on the event. Non-nullable deliberately — Prisma's compound @@unique below doesn't handle a nullable member cleanly.
  enabled    Boolean  @default(true)
  template   String? // editable message text; {{tenant}}, {{plan}}, {{amount}}, {{date}} placeholders filled at send time
  updatedAt  DateTime @updatedAt

  @@unique([event, channel, timingDays])
}

/// The real notification QUEUE/LOG the engine writes to — every notification
/// a rule says should fire is recorded here with its actual delivery
/// outcome. Renamed from BillingNotification (Priority 6) when this stopped
/// being billing-only — @@map keeps the underlying table/data untouched, a
/// pure Prisma-Client-side rename, not a migration. tenantId is nullable
/// because a platform-wide event (a critical incident) isn't owned by one
/// tenant — see notifications.ts's two recipient-resolution paths.
/// retryCount/nextAttemptAt back a real dispatch+backoff job
/// (notification_dispatch_sweep) — previously every row was permanently
/// stuck at "no_provider_configured" with nothing ever attempting delivery.
model Notification {
  id             String    @id @default(cuid())
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event          String
  channel        String
  scheduledFor   DateTime
  status         String    @default("queued") // queued | sent | failed | no_provider_configured
  content        String?
  // Resolved ONCE at queue time, not re-resolved on retry — a role/ownership
  // change after queueing shouldn't silently redirect an already-queued
  // notification to someone else.
  recipientEmail String?
  error          String?
  retryCount     Int       @default(0)
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  // Idempotency: the poller runs repeatedly and must never double-queue the
  // same reminder — one row per (tenant-or-platform)/event/channel/day,
  // enforced here rather than by "check if it exists" application logic
  // that could race.
  dedupeKey      String    @unique

  @@index([tenantId])
  @@index([status])
  @@map("BillingNotification")
}

/// Accountability trail for super-admin actions that aren't scoped to one
/// tenant (pricing changes, plan edits, AI provider switches) — AuditLog
/// requires a real tenantId (FK), so platform-level actions need their own
/// table rather than a fake/placeholder tenant id. Tenant-specific admin
/// actions (suspend/activate) still use the real AuditLog against that
/// tenant, since that's exactly what a tenant dispute would need to see.
/// RBAC-aware accountability trail. role/permission/reason/ip are optional
/// (existing call sites keep working unchanged) but populated by every
/// privileged action routed through requireAdminPermission +
/// logPrivilegedAction (admin-authz.ts) — this is what lets an incident
/// review answer "who, with what role, using what permission, and why".
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String // e.g. admin.plan_update | admin.pricing_update | admin.ai_primary_provider_change
  target     String?
  detail     Json?
  role       String? // the admin's role KEY at the moment of the action
  permission String? // the specific permission that authorized it
  reason     String? // required for elevated/dangerous actions (refunds, suspensions, role changes...)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Platform-wide (NOT tenant-scoped) daily counter per AI provider — lets the
/// super admin see which providers are actually being used, how often they're
/// failing, and (when the provider's API returns rate-limit headers) roughly
/// how much of today's quota is left, instead of that only being visible by
/// reading server logs after something's already gone quiet.
model AiProviderStat {
  id                 String    @id @default(cuid())
  provider           String // "google" | "groq" | "cerebras" | "openrouter" | "anthropic" | "openai" | "xai"
  date               String // "2026-08-19" (UTC day bucket) — one row per provider per day
  calls              Int       @default(0)
  successes          Int       @default(0)
  failures           Int       @default(0)
  lastStatus         Int?
  lastError          String?
  // Only populated when the provider's response actually included rate-limit
  // headers (Groq/OpenAI-compatible and Anthropic do; Gemini doesn't) — never
  // guessed or estimated.
  rateLimitRemaining Int?
  rateLimitLimit     Int?
  lastUsedAt         DateTime  @default(now()) @updatedAt

  @@unique([provider, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL HEALTH & INTEGRATIONS (Priority 4) — the "common operational
// event/health model". No model here re-stores a fact that already lives
// elsewhere (AiProviderStat, AiRequestLog, Connector.lastOk,
// Subscription.reconciliationNeeded) — these are either genuinely new record
// types (a job execution, an inbound webhook delivery, an incident) or thin
// config/pointer rows. System-health status is COMPUTED at read time by
// joining these with the existing tables, not duplicated into a new cache.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per external dependency the platform relies on — WhatsApp, each AI
/// provider, each payment channel, email/SMS (honestly "not configured" where
/// true), database, storage. This is CONFIG (name/links/enabled/environment),
/// never the live health number — see admin-authz.ts-gated actions in
/// integrations-actions.ts for enable/disable, and system-health.ts for how
/// live status is actually computed per category.
model Integration {
  id                   String   @id @default(cuid())
  key                  String   @unique
  category             String   // messaging | payments | ai | notification | infrastructure
  name                 String
  provider             String   // real vendor name: Meta, Safaricom, Google, Groq, ...
  environment          String   @default("production")
  // Real functional gate — assertChannelEnabled()/assertIntegrationEnabled()
  // check this before doing the thing, not just before showing a badge.
  enabled              Boolean  @default(true)
  docsUrl              String?
  providerDashboardUrl String?
  billingUrl           String?
  configJson           Json?    // NON-secret config only (webhook URL, shortcode, timeouts) — never credentials
  // List-view cache only, written by the integration_health_sweep job. Detail
  // pages always recompute live from the real underlying tables — never
  // trust this alone for a page that claims to "prove" health.
  lastCheckedAt        DateTime?
  lastCheckOk          Boolean?
  lastCheckDetail      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  credentials    IntegrationCredential[]
  paymentChannel PaymentChannel?

  @@index([category])
}

/// Designed for encrypted-at-rest Integration secrets (same AES-256-GCM
/// scheme as Connector.authConfigEnc) with a real rotation chain via
/// rotatedFromId — HONEST STATUS as of the Priority 6 system audit: this
/// table is currently unwritten scaffolding. Every real provider credential
/// in this codebase today (WhatsApp/M-Pesa/every AI provider/Resend) lives
/// in env vars, matching that established convention — not this vault. Wire
/// this up (or drop it) the day a real replace/rotate/test-connection admin
/// UI is actually built against it, rather than leaving it half-true.
model IntegrationCredential {
  id            String    @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  label         String    // "consumer_key" | "webhook_secret" | "passkey" | ...
  valueEnc      String
  maskedPreview String    // e.g. "••••••••••92AF"
  active        Boolean   @default(true)
  rotatedFromId String?   // previous credential row's id — a real rotation chain, not an overwrite
  createdById   String
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([integrationId, active])
}

/// Static registry row for a background job (see job-runner.ts's
/// registerJob/runJobNow) — counters here answer "is the poller itself even
/// running" (staleness), separate from any single JobRun's outcome.
model JobDefinition {
  key                 String   @id
  name                String
  category            String
  intervalMs          Int
  enabled             Boolean  @default(true)
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int      @default(0)
  updatedAt           DateTime @updatedAt

  runs JobRun[]
}

/// One row per actual job EXECUTION — this is what lets an incident review
/// answer "why wasn't this tenant suspended?" with "the suspension job
/// failed at 03:14 because X, retried three times, recovered at 03:18."
model JobRun {
  id          String    @id @default(cuid())
  jobKey      String
  job         JobDefinition @relation(fields: [jobKey], references: [key])
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  status      String    @default("running") // running | success | failed
  resultJson  Json?     // whatever the job returns, e.g. runBillingCycle's {reminders,renewalsAttempted,suspended,...}
  error       String?
  triggeredBy String    @default("scheduler") // scheduler | manual:<adminId>

  @@index([jobKey, startedAt])
  @@index([status])
}

/// Ledger of every INBOUND webhook/callback delivery FROM a provider (M-Pesa
/// STK/C2B, WhatsApp) — idempotencyKey gives real event-id-based duplicate
/// detection (the STK callback route today only dedupes by Payment.status,
/// which this closes). Distinct from the tenant-owned OUTBOUND `Webhook`
/// model below (P2Less -> tenant's own systems) — different direction,
/// different concern, not to be conflated.
model InboundEvent {
  id               String   @id @default(cuid())
  source           String   // mpesa_stk_callback | mpesa_c2b_confirmation | mpesa_c2b_validation | whatsapp_webhook
  eventId          String?
  idempotencyKey   String   @unique // `${source}:${eventId ?? sha256(rawBody)}`
  receivedAt       DateTime @default(now())
  processingStatus String   @default("received") // received | processed | ignored_duplicate | failed | reconciliation_required
  processingMs     Int?
  responseStatus   Int?
  retryCount       Int      @default(0)
  error            String?
  relatedPaymentId String?
  relatedTenantId  String?
  rawBody          String   // sanitized payload — needed to investigate a failed payment event
  createdAt        DateTime @default(now())

  @@index([source, receivedAt])
  @@index([relatedTenantId])
  @@index([processingStatus])
}

/// Per-attempt AI call event stream, correlated across a single callLLM()
/// invocation's full provider chain — what AiProviderStat (daily upsert
/// counter) and AiRequestLog (success-only, no correlation) can't answer:
/// "7 failures in the last 15 minutes" or "primary failed for tenant X's
/// request, fallback activated." Does not re-store cost/tokens — that stays
/// in AiRequestLog; requestId joins the two when ok=true.
model AiCallEvent {
  id            String   @id @default(cuid())
  correlationId String   // one callLLM() call = one correlationId across every provider attempt
  tenantId      String?
  provider      String
  model         String
  feature       String
  providerRank  Int      // 0 = primary in the chain, 1 = first fallback, ...
  attemptNumber Int      // retry count within THIS provider
  ok            Boolean
  statusCode    Int?
  errorSnippet  String?
  latencyMs     Int?
  requestId     String?  // joins AiRequestLog.requestId when ok=true
  createdAt     DateTime @default(now())

  @@index([correlationId])
  @@index([provider, createdAt])
  @@index([createdAt])
}

/// A detected operational problem, with a real lifecycle
/// (detected -> acknowledged -> investigating -> resolved) — never silently
/// re-opened as a duplicate; repeated detections bump occurrenceCount and
/// lastDetectedAt on the same row instead (see incident-detection.ts).
model Incident {
  id                    String    @id @default(cuid())
  number                String?   @unique // "INC-104" — nullable so existing rows don't need a backfill; see ticket-numbering.ts
  severity              String    // critical | warning | info
  source                String    // mpesa_paybill | ai_google | background_job:billing_poller | database | whatsapp
  title                 String
  status                String    @default("detected") // detected | acknowledged | investigating | resolved
  firstDetectedAt       DateTime  @default(now())
  lastDetectedAt        DateTime  @default(now())
  occurrenceCount       Int       @default(1)
  relatedIntegrationKey String?
  relatedJobKey         String?
  acknowledgedById      String?
  acknowledgedAt        DateTime?
  investigatingAt       DateTime?
  resolvedById          String?
  resolvedAt            DateTime?
  cause                 String?   // required on resolve
  resolutionNote        String?   // required on resolve
  detail                Json?     // structured evidence AT DETECTION TIME — the "actual reason", not a bare status

  events IncidentEvent[]

  @@index([status])
  @@index([source])
}

/// Timeline entry for an Incident — this plus PlatformAuditLog (written
/// alongside every lifecycle transition via logPrivilegedAction) is what
/// makes incident resolution "part of the audit trail" per the spec.
model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String   // detected | reoccurred | acknowledged | investigating | resolved | comment
  actorId    String?  // null = system-detected
  note       String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

/// Per-payment-channel config + rollup, one row per payments-category
/// Integration (M-Pesa STK / PayBill / Till, bank transfer, card). Real FK
/// to Integration, not a naming convention — "STK Push is working, PayBill
/// callbacks are delayed" requires channels to be independently trackable,
/// never one giant "M-Pesa" switch.
model PaymentChannel {
  key            String   @id // == Integration.key for the matching payments-category row
  integration    Integration @relation(fields: [key], references: [key])
  providerGroup  String   // mpesa | bank | card
  implemented    Boolean  @default(true) // false for "card" — never faked as available
  configJson     Json?    // shortcode/paybill/till number, bank account, fee schedule, limits
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastCallbackAt DateTime? // last INBOUND confirmation on this channel specifically
  updatedAt      DateTime @updatedAt
}

/// A payment-provider-reported transaction that arrived WITHOUT a
/// pre-existing pending Payment row to match against — a PayBill/Till direct
/// pay (no STK push was ever sent by us) or a bank-statement line an admin
/// entered by hand. The "reconciliation_required" philosophy generalized:
/// never invent a match, never drop the evidence. See reconciliation.ts.
model UnmatchedTransaction {
  id               String    @id @default(cuid())
  channelKey       String    // mpesa_paybill | mpesa_till | bank_transfer
  providerRef      String    // M-Pesa TransID, or a bank statement reference
  amount           Int
  currency         String    @default("KES")
  occurredAt       DateTime
  senderMsisdn     String?
  senderName       String?
  reference        String?   // BillRefNumber / bank narration — may be wrong, blank, or unmatched on purpose
  rawPayload       Json
  status           String    @default("unmatched") // unmatched | matched | ignored
  matchedTenantId  String?
  matchedPaymentId String?   @unique
  matchedById      String?
  matchedAt        DateTime?
  matchReason      String?
  createdAt        DateTime  @default(now())

  @@index([channelKey, status])
  @@index([providerRef])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM: Tenancy, billing, branding
// ─────────────────────────────────────────────────────────────────────────────

/// A tenant = one organization (school, hospital, SACCO, business, NGO, gov...).
/// Everything below is scoped to a Tenant. Tenant A can never read Tenant B.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String   @default("school") // school | hospital | sacco | business | ngo | government | ...
  // Registration reframe (roadmap doc "Registration reframe" section,
  // 2026-08-21): what the org said they want P2Less to do, collected at
  // signup alongside industry. CONTEXT for personalization later, not a
  // hard boundary on what they can do — industry above plays the same
  // honest role today (nothing in the app branches on it to gate features).
  // Nullable array of strings, e.g. ["automate_conversations","developer_api"].
  useCases  Json?
  // Registration reframe, continued (2026-08-21) — a DISTINCT question from
  // useCases above: which channels the org's own customers actually use,
  // not what the org wants to accomplish. Real demand signal for channels
  // not built yet (SMS, Instagram) without pretending they're active —
  // e.g. ["whatsapp","messenger","sms_interested"].
  channelsNeeded Json?
  status    String   @default("active") // active | suspended | trial
  // White-label branding. Free/basic tenants fall back to P2Less defaults.
  branding  Json? // { assistantName, logoText, primaryColor, welcome, poweredBy, pdfFooter }
  // Org-approved FAQs the assistant may answer verbatim (e.g. school hours, term
  // dates). Array of { q, a }. The org controls these — the AI never invents them.
  faqs      Json? // [{ q: "What are your hours?", a: "Mon–Fri, 7:30am–4:30pm." }]
  // The WhatsApp number (or other channel address) assigned to this tenant.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Card-on-file (trial-abuse deterrent, /onboard signup) — a real card
  // verified via a $0 Stripe SetupIntent, never charged. Nullable: existing
  // tenants predate this and never went through the card step.
  stripeCustomerId      String?
  stripePaymentMethodId String?

  users         User[]
  roles         Role[]
  contacts      Contact[]
  channels      Channel[]
  numbers       WhatsAppNumber[]
  widgetKeys    WidgetKey[]
  connectors    Connector[]
  conversations Conversation[]
  messages      Message[]
  otps          OtpChallenge[]
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  usageEvents   UsageEvent[]
  documents     Document[]
  subscription  Subscription?
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  tickets       SupportTicket[]
  payments      Payment[]
  products      Product[]
  orders        Order[]
  deliveryZones DeliveryZone[]
  drivers       Driver[]
  deliveryTrips DeliveryTrip[]
  notifications Notification[]
  branches      Branch[]
}

/// Configurable subscription plan. Not hard-coded — Super Admin edits these.
model Plan {
  id           String  @id @default(cuid())
  key          String  @unique // free | professional | business | enterprise
  name         String
  priceMonthly Int     @default(0) // WHOLE units of tenant currency (KES) — NOT cents; e.g. 4900 = KES 4,900/mo. Matches Payment.amount's convention.
  interval     String  @default("monthly") // monthly | half_yearly | yearly (base cadence)
  whiteLabel   Boolean @default(false)
  // Usage limits enforced by the metering layer.
  limits       Json // { users, messagesPerMonth, connectors, aiRequestsPerMonth, documentsPerMonth }
  features     Json? // free-form feature flags
  active       Boolean @default(true)
  sort         Int     @default(0)

  subscriptions Subscription[]
}

/// The billing lifecycle state machine lives in src/lib/billing-lifecycle.ts —
/// every field below exists to support REAL, centralized transitions there
/// (never scattered `if renewsAt < now` checks elsewhere in the app).
model Subscription {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  period    String   @default("monthly") // monthly | half_yearly | yearly
  status    String   @default("active") // trial | active | renewal_due | payment_pending | grace_period | suspended | cancelled
  startedAt DateTime @default(now())
  renewsAt  DateTime
  createdAt DateTime @default(now())

  // ── Automated billing lifecycle ──────────────────────────────────────────
  autoRenew            Boolean   @default(true)
  // M-Pesa number to charge for automated renewal — NEVER inferred/guessed;
  // null means auto-charge is skipped (falls back to manual "Pay Now") until
  // the tenant sets one on their Billing page.
  billingPhone         String?
  graceEndsAt          DateTime? // set when entering grace_period; auto-suspend fires once this passes
  lastPaymentAt        DateTime?
  paymentAttemptCount  Int       @default(0)
  nextPaymentAttemptAt DateTime?
  paymentFailureReason String?
  // true = "we sent an STK push but don't yet know if it succeeded or
  // failed" (no webhook received within the reconciliation window) — NEVER
  // auto-suspend while this is true; it means investigate, not "failed".
  // DERIVED, not independently written: synced from whether this tenant has
  // any subscription-purpose Payment at status="unknown" — see
  // payment-channels.ts's syncReconciliationFlag(). Kept because existing
  // read sites (runBillingCycle, clearReconciliationAction, the automation
  // page) already depend on it; the real state now lives on Payment itself
  // so order/topup payments get the same safety net subscriptions always had.
  reconciliationNeeded Boolean   @default(false)
  // Admin-assigned per tenant so a PayBill direct-pay (no STK push, no
  // pre-existing pending Payment) can be matched to this tenant by BillRefNumber
  // in the C2B confirmation webhook — see src/app/api/payments/mpesa/c2b/confirmation/route.ts.
  paybillReference     String?   @unique
}

/// A payment the organization makes to P2Less (subscription + usage). P2Less in
/// turn settles the underlying WhatsApp/provider costs — see docs/ARCHITECTURE.
/// Gateway integration (Stripe / M-Pesa Daraja) plugs into `provider`/`providerRef`.
model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Set for a super-app WALLET top-up (purpose="topup") — which contact's credit
  // balance to credit when the payment clears. Null for org-level subscription bills.
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // Set for a product purchase (purpose="order") — which order this payment
  // settles. One payment per order.
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference   String   @unique
  amount      Int // WHOLE units of `currency` (KES) — NOT cents; M-Pesa/Daraja amounts are whole-shilling, so this matches real STK push amounts directly.
  currency    String   @default("KES")
  purpose     String   @default("subscription") // subscription | usage | topup | order
  method      String   @default("mpesa") // mpesa | card | bank — legacy/loose; channelKey below is the real channel
  // "unknown" = a definitive success/failure was never received (timeout,
  // silence, network error) — NOT the same as "failed". The money may still
  // have moved on the provider's side. See src/lib/classify-outcome.ts —
  // "unknown" must never by itself feed a tenant-suspending path.
  status      String   @default("pending") // pending | paid | failed | refunded | unknown
  provider    String? // stripe | daraja | manual
  providerRef String? // gateway transaction id
  // Real payment channel — "mpesa_stk" | "mpesa_paybill" | "mpesa_till" |
  // "bank_transfer" | "card" — matches Integration.key/PaymentChannel.key.
  // Nullable so pre-Priority-4 rows and any call site not yet updated still
  // read/write fine; see src/lib/payment-channels.ts's assertChannelEnabled().
  channelKey  String?
  // Set only when status="failed" — WHY it failed, classified from Safaricom's
  // own ResultDesc/errorMessage text (see classifyMpesaFailure in mpesa.ts):
  // provider_error | timeout | invalid_request | insufficient_funds |
  // user_cancellation | wrong_pin | network_error | unknown | manual_resolution.
  // Feeds the STK failure-rate incident's category breakdown — "50% wrong PIN"
  // (normal customer behavior) reads very differently from "50% provider_error"
  // (the payment infrastructure itself may be broken).
  failureCategory String?
  failureReason   String? // raw provider message, truncated — kept for a human to read verbatim
  periodLabel String? // e.g. "2026-08"
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BUSINESS CATALOG — a tenant's own products, browsable and purchasable straight
// from WhatsApp. Native P2Less data (not a connector to an external system) so
// ANY tenant — a retailer, a school selling uniforms, a clinic selling supplies —
// can self-serve a catalog from the dashboard, independent of industry.
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int // whole units of `currency` (matches Payment's convention)
  currency    String   @default("KES")
  category    String?
  sku         String?
  imageUrl    String?
  // Free-text description of choices a customer must make before ordering, e.g.
  // "Colors: Navy, Grey, Black" or "Sizes: S, M, L, XL". Null/blank = nothing to
  // choose. Deliberately free text, not a rigid variant/inventory system.
  options     String?
  // How many are actually left. Null = not tracked (unlimited/manual via
  // inStock only) — tracking is opt-in so a business that doesn't count units
  // isn't forced to. When set, this is the real source of truth: decremented
  // atomically on every paid order, checked before a sale is even offered.
  stockQuantity Int?
  inStock     Boolean  @default(true)
  active      Boolean  @default(true) // soft-disable without deleting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([tenantId])
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  reference   String      @unique // e.g. ORD-4F9K
  items       OrderItem[]
  totalAmount Int
  currency    String      @default("KES")
  status      String      @default("pending") // pending | paid | failed | cancelled
  fulfillment String      @default("pickup") // pickup | delivery
  deliveryAddress String? // free text, only set when fulfillment = delivery
  deliveryFee Int         @default(0) // matched from a DeliveryZone; included in totalAmount, charged for real
  deliveryZoneName String? // snapshot of the matched zone's name at order time
  payment     Payment?
  deliveryTrip DeliveryTrip?
  createdAt   DateTime    @default(now())
  paidAt      DateTime?

  @@index([tenantId])
  @@index([contactId])
}

// A manually-defined delivery pricing tier, e.g. "Within Nairobi CBD" — KES 200,
// "CBD to Embakasi" — KES 500. Set by the business in the dashboard; the
// assistant matches the customer's delivery address against these by name/
// description. Deliberately manual — no Maps/geocoding API is wired in yet.
model DeliveryZone {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // e.g. "Nairobi CBD"
  description String? // extra area names/landmarks to help matching, e.g. "CBD, Moi Avenue, Tom Mboya Street"
  fee         Int // whole units of the tenant's currency
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

// A driver on the business's own roster. Availability is a single "today's
// window" (start/end time + the date it applies to) — reset conversationally,
// not managed by the owner (too much manual overhead for the owner otherwise).
model Driver {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  phone          String // WhatsApp-reachable number, used to recognize inbound messages as FROM this driver
  active         Boolean  @default(true) // soft-disable without deleting
  availableDate  String? // ISO date (YYYY-MM-DD) the window below applies to — a new day means no window set yet
  availableFrom  String? // "HH:MM"
  availableUntil String? // "HH:MM"
  busy           Boolean  @default(false) // currently on an assigned, undelivered trip — never double-booked
  createdAt      DateTime @default(now())

  trips DeliveryTrip[]

  @@index([tenantId])
  @@unique([tenantId, phone])
}

// One delivery's real lifecycle — who it was offered to, who accepted, when it
// was delivered, and the customer's own account of how it went (for driver
// accountability). Never inferred — every transition is a real confirmed event.
model DeliveryTrip {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           String    @default("searching") // searching | offered | assigned | delivered | failed | cancelled
  driverId         String?
  driver           Driver?   @relation(fields: [driverId], references: [id])
  offeredDriverIds Json? // driver IDs already offered this trip (declined or timed out) — never re-offered
  offerExpiresAt   DateTime? // sender has this long to accept before the trip moves to the next driver
  assignedAt       DateTime?
  deliveredAt      DateTime?
  customerFeedback String? // the customer's own free-text answer to "how was the delivery?"
  createdAt        DateTime  @default(now())

  @@index([tenantId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Int // snapshot of Product.price at order time — price changes later don't rewrite history
  name      String // snapshot of Product.name — survives if the product is later renamed/deleted
  optionChosen String? // e.g. "Navy, size M" — the customer's answer to Product.options, if any
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────────────────────

/// A dashboard/portal user (staff of a tenant, or a platform super admin).
model User {
  id           String   @id @default(cuid())
  tenantId     String?  // null for platform super admins
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  // Dot/plus-address-normalized form of email, populated only at self-service
  // /onboard signup (src/lib/actions.ts) to close the classic free-trial-abuse
  // trick where you+1@gmail.com / you+2@gmail.com all reach the same real
  // inbox but pass a raw-string uniqueness check as "different" accounts.
  // Nullable/unpopulated for every other user-creation path (invited staff,
  // super admin) since that path doesn't need this defense — SQLite (and
  // every other engine) allows multiple NULLs under a unique constraint, so
  // this is safe to add without backfilling existing rows.
  emailCanonical String? @unique
  passwordHash String
  // LEGACY bootstrap flag — kept in sync with adminRole.key == "super_admin"
  // so the very first seeded admin always works even before AdminRole rows
  // exist. New authorization checks (requireAdminPermission in
  // admin-authz.ts) go through adminRole.permissions, never this flag alone.
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime  @default(now())
  passwordChangedAt DateTime?

  // ── Platform admin RBAC (src/lib/admin-authz.ts) — entirely separate from
  // the tenant-staff Role/UserRole below, which governs what a SCHOOL/
  // BUSINESS's own staff can do within their own tenant, not platform ops. ──
  adminRoleId String?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id])
  // null = unrestricted (every tenant); a JSON array of tenant ids = this
  // admin may only act on/view those specific tenants ("scope" in Users →
  // Roles → Permissions → Resources → Actions → Scope → Audit).
  adminScope  Json?

  userRoles UserRole[]
  sessions  UserSession[]
  assignedTickets SupportTicket[]

  @@unique([email])
  @@index([tenantId])
  @@index([adminRoleId])
}

/// A platform-admin role (Super Admin, Finance Admin, Operations Admin,
/// Support Admin, Security Admin, Read Only, or a custom role a Super Admin
/// creates) — completely separate from the tenant-staff Role below. Holding
/// "roles.manage" is itself gated to protect against privilege escalation:
/// see requireAdminPermission's extra super_admin-only check on that one
/// specific permission in admin-authz.ts.
model AdminRole {
  id          String   @id @default(cuid())
  key         String   @unique // super_admin | finance_admin | operations_admin | support_admin | security_admin | read_only_admin | custom-<slug>
  name        String
  permissions Json // string[] of AdminPermission keys — see admin-permissions.ts
  isBuiltIn   Boolean  @default(false) // built-ins can't be deleted, only their permission list can be inspected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

/// A real, DB-backed, revocable session — the JWT cookie alone (see auth.ts)
/// is stateless and can't actually be revoked; this row is what makes
/// "revoke this admin's session" a genuine action rather than decorative.
/// Applies to every User login (tenant staff AND platform admins), since
/// auth.ts is shared, but only surfaced for platform admins on
/// /admin/security today.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
}

/// Every login attempt, success or failure — the real evidence behind
/// "failed login attempts" on the admin security centre, not a guess.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

/// A role within a tenant, carrying a set of permission strings.
/// Roles are configurable per organization (RBAC).
model Role {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String // owner | admin | integration_manager | staff | parent | ...
  name        String
  permissions Json // string[] e.g. ["connectors.manage","conversations.read","student.results.read"]
  isSystem    Boolean @default(false)

  userRoles    UserRole[]
  contactRoles ContactRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Universal Platform roadmap Phase 2 (2026-08-19): mirrors User.adminScope's
  // exact shape/meaning for the tenant-staff RBAC system — null = unrestricted
  // (every branch), a JSON array of Branch ids = this role assignment is
  // scoped to only those branches (e.g. "Branch Manager" at Nairobi only,
  // vs. "Regional Manager" scoped to [Nairobi, Mombasa]). Lives on the
  // ASSIGNMENT (UserRole), not the Role definition, since the same Role
  // (e.g. "branch_manager") can be assigned to different users at different
  // branches. NOT YET enforced at any call site — see hasBranchAccess() in
  // src/lib/branches.ts, which exists but isn't called from dashboard
  // authorization yet, pending a real multi-branch tenant to validate
  // against (see docs/ROADMAP-UNIVERSAL-PLATFORM-2026-08-19.md Phase 2).
  branchScope Json?

  @@unique([userId, roleId])
}

/// A Contact is the *end user* on a conversational channel (e.g. a parent's
/// WhatsApp identity). Distinct from a dashboard User. This is who talks to the
/// bot. A phone number alone is NOT treated as sufficient auth for sensitive data.
model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelType String   @default("whatsapp") // the channel this address lives on
  address     String // phone number / chat id — unique per tenant+channel
  displayName String?
  phoneVerified Boolean @default(false)
  // Super-app credit wallet: end users spend credits per tool use; topped up via
  // M-Pesa. New contacts get a few free credits so anyone can try it instantly.
  credits     Int      @default(30)
  // Links to records in external systems this contact is authorized to access,
  // e.g. { "students": ["STU-001","STU-014"] }. Populated from the connected
  // system during onboarding — this is the authorization ground truth.
  grants      Json?
  createdAt   DateTime @default(now())

  contactRoles  ContactRole[]
  conversations Conversation[]
  otps          OtpChallenge[]
  authSessions  AuthSession[]
  documents     Document[]
  payments      Payment[]
  orders        Order[]
  tickets       SupportTicket[]

  @@unique([tenantId, channelType, address])
  @@index([tenantId])
}

model ContactRole {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([contactId, roleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NUMBER REGISTRY — the routing backbone.
//
// The organization's OWN WhatsApp number is the front door. A user messages that
// number directly (P2Less is invisible behind it). The DESTINATION number is the
// routing key: number → tenant → configuration. One org may own several numbers
// (General, HR, Finance…), each with its own capabilities/branding.
// ─────────────────────────────────────────────────────────────────────────────

model WhatsAppNumber {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Universal Platform roadmap Phase 2 (2026-08-19): which Branch this number
  // is the front door for. Null = tenant has no real multi-branch setup yet,
  // resolveNumberBranch() (branches.ts) falls back to the tenant's isDefault
  // branch — so this is invisible for every single-branch tenant today.
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // The public E.164 number users message (e.g. +254711562526). Globally unique
  // across the platform — this is what routes an inbound message to a tenant.
  phoneNumber        String   @unique
  // What the user sees as the sender identity — the ORGANIZATION, not "P2Less".
  displayName        String
  department         String? // General | HR | Finance | Support | Admissions …
  // WhatsApp Cloud API identifiers (the webhook routes on phoneNumberId).
  wabaId             String?
  phoneNumberId      String?  @unique
  status             String   @default("active") // active | disabled
  verificationStatus String   @default("verified") // verified | pending
  branding           Json? // per-number branding override (falls back to tenant)
  webhookConfig      Json?
  createdAt          DateTime @default(now())

  conversations Conversation[]

  @@index([tenantId])
}

// Universal Platform roadmap Phase 8e (2026-08-20) — the embeddable website
// chat widget's registry entry. Deliberately NOT a private secret like
// ApiKey — `key` is meant to be pasted into a public <script> tag, visible in
// any page's source, so the security boundary is origin allowlisting + rate
// limiting (enforced in the widget route), not keeping this value hidden.
model WidgetKey {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String    @unique // public identifier embedded in the <script> tag
  allowedOrigins Json // string[]; empty = dev/testing mode, any origin allowed (logged, not silent)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHANNELS (transport type; the engine is channel-agnostic)
// ─────────────────────────────────────────────────────────────────────────────

// Generic per-channel-type resource, one row per tenant per channel type —
// exactly the "channel resource" concept from the "Registration reframe"
// section of the roadmap doc. Existed in the schema but had zero real rows
// anywhere in the app before 2026-08-21 (Conversation.channelId was always
// null; only Conversation.numberId, a WhatsApp-specific FK, was ever
// populated). Now wired: finalizeOnboarding() (actions.ts) creates one
// alongside every new WhatsAppNumber. Deliberately NOT yet wired into
// Conversation routing or dashboard UI — no second real channel exists yet
// to make that worth building (see the roadmap doc for why this stays a
// data-model-only step for now).
model Channel {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // whatsapp | webchat | sms | telegram
  address   String? // the tenant's number/handle on this channel
  status    String  @default("active") // active | disabled
  config    Json? // provider config (never expose secrets to clients)

  conversations Conversation[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@index([type, address])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONNECTOR FRAMEWORK (the integration layer)
// ─────────────────────────────────────────────────────────────────────────────

/// A configured connection to an external system (REST for the MVP; the schema
/// carries `kind` so GraphQL/SOAP/DB connectors slot in without migration).
model Connector {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  kind         String   @default("rest") // rest | graphql | soap | database | custom
  baseUrl      String
  authType     String   @default("none") // none | api_key | bearer | basic | oauth2 | jwt
  // Credentials are encrypted at rest (AES-256-GCM). Never returned to clients
  // in plaintext and never logged. See src/lib/crypto.ts.
  authConfigEnc String?
  timeoutMs    Int      @default(8000)
  maxRetries   Int      @default(1)
  status       String   @default("active") // active | disabled
  // Health, updated by the engine on each call.
  lastCheckAt  DateTime?
  lastOk       Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actions ConnectorAction[]

  @@index([tenantId])
}

/// A single capability exposed by a connector: an endpoint + how to call it +
/// how to map the response + who is allowed + whether step-up auth is required.
/// This is what the Connector Builder produces and the AI selects as a "tool".
model ConnectorAction {
  id                String  @id @default(cuid())
  connectorId       String
  connector         Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  key               String // GET_STUDENT_RESULTS | GET_STUDENT_BALANCE | ...
  name              String
  description       String?
  operation         String  @default("read") // read | write
  method            String  @default("GET") // GET | POST | PUT | PATCH | DELETE
  path              String // /students/{studentId}/results  ({param} placeholders)
  // Declares the params this action needs and how to source them.
  // [{ name, in: "path"|"query"|"body", required, from: "entity"|"grant"|"const", entity?, const? }]
  paramSchema       Json
  // Dot-path map from raw response → tidy fields, e.g. { "name":"student.name" }
  responseMapping   Json?
  // Permission an actor must hold to run this action.
  requiredPermission String?
  // Resource guard: the grant key (e.g. "students") the target id must be in.
  resourceGrantKey  String?
  resourceParam     String? // which param holds the resource id (e.g. "studentId")
  // Step-up auth: sensitive actions require a verified OtpChallenge/AuthSession.
  requiresStepUp    Boolean @default(false)
  // Write actions ask for explicit confirmation before executing.
  requiresConfirm   Boolean @default(false)
  // Natural-language phrases + keywords the intent engine matches against.
  samplePhrases     Json? // string[]
  // Template for formatting a successful response back to the user.
  replyTemplate     String?
  // Confirmation prompt for write actions ({placeholders} filled from params).
  confirmTemplate   String?
  // Optionally produce a document from the response.
  documentKind      String? // e.g. "report_card" | null
  enabled           Boolean @default(true)

  // ── Universal Platform roadmap (Phase 1, 2026-08-19) — this model already IS
  // the "Capability" the vision doc describes (connector + method/path=action,
  // paramSchema=input, responseMapping=output, requiredPermission/resourceGrantKey
  // =authorization, requiresStepUp/requiresConfirm=confirmation), so these fields
  // EXTEND it in place rather than duplicating it into a parallel table. Additive,
  // defaulted, NOT YET read by any runtime code — Phase 3 wires an explicit
  // evaluateCapabilityGate() that consults riskLevel/approvalRequired; today's
  // dispatchAction still only looks at requiresStepUp/requiresConfirm.
  riskLevel         String  @default("low") // low | medium | high — informs future confirmation/approval defaults, not yet enforced
  // Distinct from requiresConfirm (the ACTOR confirms their own action):
  // approvalRequired means a DIFFERENT human must approve before execution,
  // routed through the Notification Engine once Phase 3 wires this up.
  approvalRequired  Boolean @default(false)
  // Free-form note on what should happen if this action fails mid-execution
  // (e.g. "rollback stock hold", "notify ops") — documentation today, not yet
  // consulted by any error-handling code.
  failureBehavior   String?

  @@unique([connectorId, key])
  @@index([connectorId])
}

/// Universal Platform roadmap Phase 7 (2026-08-20) — a platform-curated
/// connector marketplace. Deliberately NOT tenant-scoped (no tenantId) —
/// this is a reusable STARTER, not a live connection; installing one goes
/// through the exact same reviewed-draft-then-create flow Phase 6 built for
/// OpenAPI import (src/lib/actions.ts::createConnectorFromDraftAction),
/// just seeded from `actions` here instead of a freshly-parsed spec.
/// Publishing is platform-curated only for now (confirmed with the user
/// 2026-08-20) — no submission/review/ownership workflow exists because
/// there's no other publisher yet; the vision doc's open-developer-
/// publishing idea stays explicitly deferred, not half-built.
model ConnectorTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // "school_system" | "payroll_hr" | ...
  name        String
  description String?
  category    String // school | payroll | hospital | retail | custom — loosely matches Tenant.industry
  // Example/placeholder only — always editable at install time. A template
  // installed by a DIFFERENT tenant almost certainly needs a different real
  // base URL; this just shows what a working example looks like.
  baseUrlHint String
  authType    String  @default("api_key")
  // DraftAction[]-shaped (src/lib/openapi-import.ts) — same fields the
  // review-then-create flow already knows how to render and submit.
  actions     Json
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// UNIVERSAL PLATFORM ROADMAP (Phase 1, 2026-08-19) — see
// docs/ROADMAP-UNIVERSAL-PLATFORM-2026-08-19.md. Schema-only, additive, not yet
// referenced by User/Contact/WhatsAppNumber or any runtime code — Phase 2 wires
// branch-scoped permissions/routing/config on top of this.
// ─────────────────────────────────────────────────────────────────────────────

/// A node in an organization's internal hierarchy. Deliberately ONE
/// self-referential model rather than separate Branch/Region tables — the
/// vision doc's own examples show hierarchies of varying depth (Organization →
/// Branch, or Organization → Country → Region → Branch), and a "region" is
/// structurally just a Branch that has children rather than its own concept.
/// `kind` is descriptive labeling only; nothing currently branches behavior on it.
model Branch {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentBranchId String?
  parent         Branch?  @relation("BranchHierarchy", fields: [parentBranchId], references: [id], onDelete: SetNull)
  children       Branch[] @relation("BranchHierarchy")
  name           String
  kind           String   @default("branch") // branch | region | hq — labeling only
  code           String? // short internal code, e.g. "NBO" — optional, not unique (two orgs could both use "NBO")
  // The branch every pre-existing tenant was auto-migrated onto — see
  // scripts/backfill-default-branches.ts. Exactly one per tenant; never delete
  // a tenant's only isDefault branch — resolveNumberBranch() (branches.ts)
  // falls back to it whenever a WhatsAppNumber has no explicit branchId set.
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  numbers       WhatsAppNumber[]
  conversations Conversation[]

  @@index([tenantId])
  @@index([parentBranchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONVERSATION ENGINE
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id])
  // The organization number this conversation is happening on (the front door).
  numberId  String?
  number    WhatsAppNumber? @relation(fields: [numberId], references: [id])
  // Universal Platform roadmap Phase 2 (2026-08-19) — resolved ONCE via
  // resolveNumberBranch() at creation, same as tenantId/numberId (routing
  // metadata, not conversational state — deliberately NOT stored in the
  // `context` JSON blob, since most emit() call sites replace that wholesale
  // rather than merge it, so anything stashed there silently vanishes).
  // Null for conversations created before this field existed.
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status    String   @default("open") // open | awaiting_otp | awaiting_param | awaiting_confirm | escalated | closed
  // Short-term conversational memory + pending-step state:
  // { lastEntities, pendingActionKey, pendingParams, missingParam, otpChallengeId, ... }
  context   Json?
  assignedUserId String? // set when escalated to a human
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  tickets  SupportTicket[]

  @@index([tenantId])
  @@index([contactId])
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // in | out
  body           String
  // Diagnostic metadata (intent, action, latency) — never raw credentials.
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTHENTICATION (OTP / step-up / sessions)
// ─────────────────────────────────────────────────────────────────────────────

model OtpChallenge {
  id          String   @id @default(cuid())
  // Nullable: a step_up/login challenge always has both (existing behavior,
  // unchanged). An onboard_signup challenge has NEITHER — the tenant/contact
  // don't exist yet, that's the whole point of verifying the phone number
  // BEFORE creating them — so it carries `phone` instead.
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phone       String? // set instead of contactId for pre-tenant flows (e.g. /onboard signup)
  ip          String? // onboard_signup only — lets the admin anomaly check count successful signups clustered on one IP
  purpose     String   @default("step_up") // step_up | login | onboard_signup
  codeHash    String // OTP is hashed at rest, never stored in plaintext
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([contactId])
  @@index([tenantId])
  @@index([phone])
}

/// A short-lived verified session granted after successful OTP, so a contact
/// isn't re-challenged on every sensitive request within the window.
model AuthSession {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([contactId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GOVERNANCE: audit, usage metering, documents, support
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId   String
  actorType   String // contact | user | system
  actorId     String?
  action      String // e.g. connector.execute | otp.verify | authz.deny
  target      String? // connector action key / resource id
  success     Boolean
  // Sanitized detail. Secrets and full PII are minimized here by design.
  detail      Json?
  // RBAC context, populated when a platform admin (not tenant staff/contact)
  // performed this — see PlatformAuditLog for the "why" behind these fields.
  role        String?
  permission  String?
  reason      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([requestId])
}

/// Usage metering feeds both plan-limit enforcement and future usage billing.
model UsageEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // message_in | message_out | api_call | ai_request | document
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

model Document {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])
  // Set for kind="ticket_attachment" — reuses this model rather than a new
  // file-storage table, since Document already has everything a ticket
  // attachment needs (token-addressed secure access, filename, content).
  ticketId   String?
  ticket     SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind       String // report_card | receipt | statement | ticket_attachment | ...
  filename   String
  content    String // MVP: inline HTML/text; production: object-storage key
  token      String   @unique // for temporary secure access URLs
  // Every other Document write site sets a real TTL for a temporary secure
  // link; a ticket attachment shouldn't expire while the ticket is open, so
  // it gets a far-future sentinel instead — keeps this column non-nullable
  // for every other kind that genuinely depends on it expiring.
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([ticketId])
}

// A CUSTOMER's problem report — distinct from an Incident (something wrong
// with the PLATFORM). One Incident can generate many SupportTickets; see
// relatedIncidentId below and suggestRelatedTickets() in incident-detection.ts.
// Number/status/priority/category are real workflow state; internal notes and
// customer-visible responses live in the child TicketEvent model (mirrors
// IncidentEvent) rather than inline fields, so they interleave chronologically
// instead of living in two disconnected arrays.
model SupportTicket {
  id             String    @id @default(cuid())
  number         String?   @unique // "TCK-42" — nullable so it's backfill-free; see ticket-numbering.ts
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // The END USER who reported it (a Contact, not a staff User) — nullable
  // because not every escalation path resolves a contact at creation time.
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  subject        String
  description    String?
  category       String    @default("general") // billing | technical | account | whatsapp | ai | other | general
  priority       String    @default("normal")  // low | normal | high | urgent
  status         String    @default("open")    // open | assigned | in_progress | waiting_on_customer | resolved | closed | reopened
  assignedAdminId String?
  assignedAdmin  User?     @relation(fields: [assignedAdminId], references: [id])
  slaDeadlineAt  DateTime?
  slaBreached    Boolean   @default(false) // written by runTicketSlaSweep(), not computed ad hoc at every read
  resolution       String?
  resolutionReason String?
  resolvedAt        DateTime?
  resolvedById      String?
  // Soft references — plain indexed String, no hard @relation. Mirrors the
  // existing convention (Incident.relatedJobKey, InboundEvent.relatedPaymentId):
  // Incident isn't tenant-scoped, so a hard relation here would be the wrong
  // shape; Payment doesn't need one either since this is a lookup pointer,
  // not an ownership relation.
  relatedPaymentId  String?
  relatedIncidentId String?
  // Same soft-reference convention as relatedPaymentId/relatedIncidentId
  // above — the specific Message this ticket is actually about, set
  // manually by a reviewer during quality triage (see waterfall step 1 in
  // docs/PUBLIC-FEEDBACK-QUALITY-CENTRE-2026-08-23.md), never auto-detected.
  relatedMessageId  String?
  // Quality-programme fields, Phase A of the Evidence & Assurance groundwork
  // (docs/PUBLIC-FEEDBACK-QUALITY-CENTRE-2026-08-23.md). Distinct from
  // `category` above, which is the general support-ticket taxonomy — these
  // two only apply once a ticket enters the AI-quality investigation
  // waterfall, which is a subset of all tickets.
  source          String  @default("internal") // internal | tenant | public_report — who originated this ticket
  qualityCategory String? // null = not a quality-programme ticket yet. One of: bug | ai_hallucination | knowledge_gap | incorrect_source_data | incorrect_connector_result | intent_classification_error | authorization_error | integration_failure | conversation_context_failure | correct_user_misunderstanding | unknown_investigating
  // Root cause (qualityCategory above) and corrective action are DELIBERATELY
  // separate decisions — a category doesn't imply "needs a developer". Set
  // together, after qualityCategory, never defaulted: forces the reviewer to
  // actually decide the cheapest-appropriate layer (principle 6's correction-
  // routing ladder) instead of reflexively filing everything as a code task.
  actionRequired String? // null = not decided yet. One of: no_action | knowledge_update | configuration_change | prompt_change | connector_data_fix | ai_model_change | operational_procedure | user_training | monitoring_change | documentation_change | ux_change | code_change
  actionReason   String? // required alongside actionRequired — why this layer, not a cheaper one. Makes the decision auditable, not just a label.
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  events      TicketEvent[]
  attachments Document[]

  @@index([tenantId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([relatedIncidentId])
  @@index([relatedPaymentId])
  @@index([qualityCategory])
  @@index([actionRequired])
}

/// Timeline entry for a SupportTicket — internal notes AND customer-visible
/// responses live here as one typed stream (distinguished by `visibility`),
/// not two parallel arrays, because a real support case interleaves them
/// chronologically (an internal note at 10:15, a customer reply at 10:20,
/// another internal note at 10:22) and splitting them would lose that order.
/// Mirrors IncidentEvent exactly — same proven shape for the same problem.
model TicketEvent {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type       String   // created | assigned | status_changed | internal_note | customer_response | attachment_added | linked_incident | linked_payment | resolved | reopened
  actorId    String?  // null = system/automated (e.g. auto-created from an escalation)
  visibility String   @default("internal") // internal | customer
  body       String?
  detail     Json?    // structured payload for non-text events — render via the shared EvidencePanel
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DEVELOPER PLATFORM (API keys, webhooks) — foundation
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // shown to the user; the full key is only shown once
  keyHash    String
  scopes     Json // string[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String // used to sign deliveries (HMAC)
  events    Json // string[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ═════════════════════════════════════════════════════════════════════════════
// DEMO EXTERNAL SYSTEM — "Riverside School Management System"
//
// These tables simulate a THIRD-PARTY school system. P2Less has NO direct
// access to them: they are served over HTTP at /api/demo-school/* behind an
// API key, and P2Less reaches them ONLY through a configured Connector making
// real HTTP calls. This proves the integration is real, not hard-coded.
// In a real deployment these tables live in the school's own database.
// ═════════════════════════════════════════════════════════════════════════════

model DemoStudent {
  id           String   @id @default(cuid())
  externalId   String   @unique // STU-001 — the id the school system exposes
  name         String
  grade        String
  parentPhones Json // string[] — phones the school has on file for guardians
  arrivedAt    String? // today's gate check-in time, or null
  leftAt       String?

  results      DemoResult[]
  fees         DemoFeeAccount?
  attendance   DemoAttendance[]
  appointments DemoAppointment[]
}

/// A booked parent-teacher appointment in the external school system. Created by
/// P2Less through a WRITE connector action (POST), after user confirmation.
model DemoAppointment {
  id         String   @id @default(cuid())
  reference  String   @unique // human-friendly ref, e.g. APT-3F9K
  studentId  String
  student    DemoStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       String
  time       String
  reason     String
  status     String   @default("confirmed")
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model DemoResult {
  id        String @id @default(cuid())
  studentId String
  student   DemoStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      String
  subject   String
  score     Int
  grade     String
}

model DemoFeeAccount {
  id        String @id @default(cuid())
  studentId String @unique
  student   DemoStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currency  String @default("KES")
  billed    Int
  paid      Int
  dueDate   String
}

model DemoAttendance {
  id        String @id @default(cuid())
  studentId String
  student   DemoStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String
  status    String // present | absent | late
}

model DemoAnnouncement {
  id        String @id @default(cuid())
  title     String
  body      String
  eventDate String
}

model DemoTimetableSlot {
  id      String @id @default(cuid())
  grade   String
  day     String
  period  Int
  subject String
}

// ── DEMO EXTERNAL SYSTEM: Hamzone Payroll/HR (served at /api/demo-payroll/*) ──
model DemoEmployee {
  id           String  @id @default(cuid())
  externalId   String  @unique // EMP-184
  name         String
  title        String
  phones       Json // string[] guardian/registered phones on file
  leaveBalance Int     @default(21)

  payslips      DemoPayslip[]
  leaveRequests DemoLeaveRequest[]
  meetings      DemoMeeting[]
}

model DemoMeeting {
  id         String   @id @default(cuid())
  reference  String   @unique // MTG-3F9K
  employeeId String
  employee   DemoEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String
  time       String
  topic      String?
  status     String   @default("confirmed") // confirmed | cancelled
  createdAt  DateTime @default(now())
}

model DemoPayslip {
  id         String @id @default(cuid())
  employeeId String
  employee   DemoEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String // "2026-07"
  currency   String @default("KES")
  gross      Int
  deductions Int
  net        Int
}

model DemoLeaveRequest {
  id         String   @id @default(cuid())
  reference  String   @unique // LR-3F9K
  employeeId String
  employee   DemoEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  String
  endDate    String
  reason     String?
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
}

// ── DEMO EXTERNAL SYSTEM: Nairobi Hospital (served at /api/demo-hospital/*) ──
model DemoPatient {
  id           String  @id @default(cuid())
  externalId   String  @unique // PT-5521
  name         String
  phones       Json
  nextApptDate String?
  nextApptTime String?
  nextApptDept String?
}

// ── DEMO EXTERNAL SYSTEM: Kilimani Retail (served at /api/demo-business/*) ──
model DemoOrder {
  id         String @id @default(cuid())
  reference  String @unique // ORD-3388
  customerPhone String
  item       String
  status     String // processing | shipped | delivered
  eta        String?
}
